FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "FleetwayLOL"
      VALUE "FileDescription", "Graphite — Portable Text & Note Editor"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", "Graphite"
      VALUE "OriginalFilename", "Graphite.exe"
      VALUE "ProductName", "Graphite"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
